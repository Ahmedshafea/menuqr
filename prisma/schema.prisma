generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                      String                       @id @default(cuid())
  name                    String
  email                   String                       @unique
  passwordHash            String
  sessionVersion          Int                          @default(0)
  emailVerified           DateTime?
  image                   String?
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  phone                   String?
  phoneVerifiedAt         DateTime?
  language                String                       @default("ar")
  isActive                Boolean                      @default(true)
  auditLogs               AuditLog[]
  customerProfile         CustomerProfile?
  customerOrders          Order[]                      @relation("CustomerOrders")
  orderMessages           OrderMessage[]
  orderStatusChanges      OrderStatusHistory[]
  orderActions            OrderActionLog[]
  notificationsRead       RestaurantNotificationRead[]
  resetTokens             PasswordResetToken[]
  restaurantMemberships   RestaurantMember[]
  roles                   UserRole[]
  verificationTokens      VerificationToken[]
  promotionUsages         PromotionUsage[]
  platformSettingsUpdated PlatformSetting[]            @relation("PlatformSettingUpdatedBy")
  featureFlagsUpdated     FeatureFlag[]                @relation("FeatureFlagUpdatedBy")
  homepageSectionsUpdated HomepageSection[]            @relation("HomepageSectionUpdatedBy")
  billingCheckoutIntents  BillingCheckoutIntent[]

  @@index([isActive, createdAt])
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  role      Role
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role])
}

model RestaurantMember {
  id           String     @id @default(cuid())
  userId       String
  restaurantId String
  role         Role       @default(STAFF)
  createdAt    DateTime   @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId])
  @@index([restaurantId, role])
}

model CustomerProfile {
  id                  String                       @id @default(cuid())
  userId              String                       @unique
  avatar              String?
  birthDate           DateTime?
  marketingConsent    Boolean                      @default(false)
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  addresses           CustomerAddress[]
  favoriteProducts    CustomerFavoriteProduct[]
  favoriteRestaurants CustomerFavoriteRestaurant[]
  user                User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CustomerAddress {
  id            String          @id @default(cuid())
  customerId    String
  title         String
  address       String
  latitude      Decimal?        @db.Decimal(10, 7)
  longitude     Decimal?        @db.Decimal(10, 7)
  street        String?
  district      String?
  city          String?
  governorate   String?
  country       String?
  postalCode    String?
  buildingName  String?
  floor         String?
  apartment     String?
  landmark      String?
  deliveryNotes String?
  isDefault     Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  customer      CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, isDefault])
}

model CustomerFavoriteRestaurant {
  customerId   String
  restaurantId String
  createdAt    DateTime        @default(now())
  customer     CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  restaurant   Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@id([customerId, restaurantId])
  @@index([restaurantId])
}

model CustomerFavoriteProduct {
  customerId String
  productId  String
  createdAt  DateTime        @default(now())
  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([customerId, productId])
  @@index([productId])
}

model VerificationToken {
  id      String   @id @default(cuid())
  token   String   @unique
  expires DateTime
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  token   String   @unique
  expires DateTime
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Restaurant {
  id                     String                       @id @default(cuid())
  name                   String
  nameAr                 String?
  slug                   String                       @unique
  description            String?
  email                  String?
  phone                  String?
  whatsapp               String
  logoUrl                String?
  coverUrl               String?
  primaryColor           String                       @default("#e85d2a")
  accentColor            String                       @default("#f6c453")
  currency               String                       @default("EGP")
  locale                 String                       @default("en")
  isActive               Boolean                      @default(true)
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  address                String?
  governorate            String?
  city                   String?
  district               String?
  area                   String?
  street                 String?
  postalCode             String?
  descriptionAr          String?
  mapUrl                 String?
  facebookUrl            String?
  instagramUrl           String?
  analytics              AnalyticsEvent[]
  auditLogs              AuditLog[]
  branches               Branch[]
  categories             Category[]
  customerFavorites      CustomerFavoriteRestaurant[]
  orders                 Order[]
  products               Product[]
  members                RestaurantMember[]
  settings               Setting?
  subscriptions          Subscription[]
  customDomain           CustomDomain?
  notifications          RestaurantNotification[]
  optionGroups           ProductOptionGroup[]
  options                ProductOption[]
  drivers                DeliveryDriver[]
  reviews                RestaurantReview[]
  latitude               Decimal?                     @db.Decimal(10, 7)
  longitude              Decimal?                     @db.Decimal(10, 7)
  promotions             Promotion[]
  coupons                Coupon[]
  promotionUsages        PromotionUsage[]
  billingCheckoutIntents BillingCheckoutIntent[]
}

model Branch {
  id                    String            @id @default(cuid())
  name                  String
  slug                  String
  phone                 String?
  whatsappNumber        String?
  useRestaurantWhatsapp Boolean           @default(true)
  email                 String?
  address               String
  city                  String?
  state                 String?
  governorate           String?
  district              String?
  area                  String?
  street                String?
  country               String?
  postalCode            String?
  latitude              Decimal?          @db.Decimal(10, 7)
  longitude             Decimal?          @db.Decimal(10, 7)
  googleMapsUrl         String?
  isActive              Boolean           @default(true)
  restaurantId          String
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  restaurant            Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders                Order[]
  workingHours          WorkingHour[]
  promotionBranches     PromotionBranch[]

  @@unique([restaurantId, slug])
  @@index([restaurantId, isActive])
  @@index([restaurantId, updatedAt])
}

model WorkingHour {
  id        String  @id @default(cuid())
  dayOfWeek Int
  opensAt   String?
  closesAt  String?
  isClosed  Boolean @default(false)
  branchId  String
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, dayOfWeek])
}

model Category {
  id                  String              @id @default(cuid())
  name                String
  nameAr              String?
  description         String?
  sortOrder           Int                 @default(0)
  isActive            Boolean             @default(true)
  restaurantId        String
  createdAt           DateTime            @default(now())
  restaurant          Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products            Product[]
  promotionCategories PromotionCategory[]

  @@index([restaurantId, sortOrder])
}

model Product {
  id                 String                      @id @default(cuid())
  name               String
  nameAr             String?
  description        String?
  descriptionAr      String?
  price              Decimal                     @db.Decimal(10, 2)
  isAvailable        Boolean                     @default(true)
  availability       ProductAvailability         @default(AVAILABLE)
  isFeatured         Boolean                     @default(false)
  sortOrder          Int                         @default(0)
  restaurantId       String
  categoryId         String
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  stock              Int?
  lowStockThreshold  Int?
  customerFavorites  CustomerFavoriteProduct[]
  extras             Extra[]
  orderItems         OrderItem[]
  category           Category                    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  restaurant         Restaurant                  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  images             ProductImage[]
  optionGroups       ProductOptionGroupProduct[]
  standaloneOptions  ProductOption[]             @relation("StandaloneOptionProduct")
  promotionProducts  PromotionProduct[]
  freeItemPromotions Promotion[]                 @relation("PromotionFreeProduct")

  @@index([restaurantId, categoryId])
  @@index([categoryId, sortOrder])
  @@index([restaurantId, isAvailable, sortOrder])
  @@index([restaurantId, stock])
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  publicId  String?
  alt       String?
  sortOrder Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model Extra {
  id              String           @id @default(cuid())
  name            String
  nameAr          String?
  price           Decimal          @db.Decimal(10, 2)
  isAvailable     Boolean          @default(true)
  productId       String
  product         Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItemExtras OrderItemExtra[]

  @@index([productId, isAvailable])
}

model Order {
  id                  String               @id @default(cuid())
  orderNumber         String               @unique
  customerName        String
  customerPhone       String
  deliveryAddress     String?
  deliveryLatitude    Decimal?             @db.Decimal(10, 7)
  deliveryLongitude   Decimal?             @db.Decimal(10, 7)
  street              String?
  district            String?
  city                String?
  governorate         String?
  country             String?
  postalCode          String?
  buildingName        String?
  floor               String?
  apartment           String?
  landmark            String?
  deliveryNotes       String?
  notes               String?
  subtotal            Decimal              @db.Decimal(10, 2)
  discountAmount      Decimal              @default(0) @db.Decimal(10, 2)
  deliveryFee         Decimal              @default(0) @db.Decimal(10, 2)
  serviceFee          Decimal              @default(0) @db.Decimal(10, 2)
  taxAmount           Decimal              @default(0) @db.Decimal(10, 2)
  total               Decimal              @db.Decimal(10, 2)
  status              OrderStatus          @default(NEW)
  restaurantId        String
  branchId            String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  accessToken         String               @unique
  customerUserId      String?
  branch              Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer            User?                @relation("CustomerOrders", fields: [customerUserId], references: [id], map: "Order_customerId_fkey")
  restaurant          Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items               OrderItem[]
  messages            OrderMessage[]
  statusHistory       OrderStatusHistory[]
  actionLogs          OrderActionLog[]
  driver              DeliveryDriver?      @relation(fields: [driverId], references: [id], onDelete: SetNull)
  driverId            String?
  fulfillmentType     FulfillmentType      @default(DELIVERY)
  driverAssignedAt    DateTime?
  outForDeliveryAt    DateTime?
  deliveredAt         DateTime?
  estimatedArrivalAt  DateTime?
  review              RestaurantReview?
  promotionOrders     PromotionOrder[]
  promotionUsages     PromotionUsage[]
  couponCode          String?
  originalSubtotal    Decimal              @default(0) @db.Decimal(10, 2)
  finalSubtotal       Decimal              @default(0) @db.Decimal(10, 2)
  inventoryRestoredAt DateTime?
  clientRequestId     String?

  @@unique([restaurantId, clientRequestId])
  @@index([restaurantId, createdAt])
  @@index([customerUserId, createdAt])
  @@index([restaurantId, status, createdAt])
  @@index([restaurantId, fulfillmentType, createdAt])
  @@index([branchId, createdAt])
  @@index([driverId, status])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  userId    String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

model OrderActionLog {
  id        String   @id @default(cuid())
  orderId   String
  userId    String?
  action    String
  details   Json?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

model OrderMessage {
  id        String   @id @default(cuid())
  body      String
  sender    Role
  orderId   String
  userId    String?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@index([orderId, createdAt])
}

model OrderItem {
  id              String            @id @default(cuid())
  productName     String
  unitPrice       Decimal           @db.Decimal(10, 2)
  quantity        Int
  notes           String?
  isComplimentary Boolean           @default(false)
  orderId         String
  productId       String?
  order           Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product?          @relation(fields: [productId], references: [id])
  extras          OrderItemExtra[]
  options         OrderItemOption[]

  @@index([orderId])
}

model OrderItemExtra {
  id          String    @id @default(cuid())
  name        String
  price       Decimal   @db.Decimal(10, 2)
  orderItemId String
  extraId     String?
  extra       Extra?    @relation(fields: [extraId], references: [id])
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
}

model Plan {
  id                     String                  @id @default(cuid())
  code                   String                  @unique
  name                   String                  @unique
  nameAr                 String?
  description            String?
  descriptionAr          String?
  price                  Decimal                 @db.Decimal(10, 2)
  currency               String                  @default("EGP")
  interval               BillingInterval         @default(MONTHLY)
  displayOrder           Int                     @default(0)
  isActive               Boolean                 @default(true)
  isRecommended          Boolean                 @default(false)
  maxProducts            Int
  maxBranches            Int
  maxStaff               Int
  analyticsEnabled       Boolean                 @default(false)
  customDomain           Boolean                 @default(false)
  lemonSqueezyVariantId  String?                 @unique
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  subscriptions          Subscription[]
  features               PlanFeature[]
  launchPromotions       LaunchPromotion[]
  billingCheckoutIntents BillingCheckoutIntent[]
}

model CustomDomain {
  id            String             @id @default(cuid())
  restaurantId  String             @unique
  domain        String             @unique
  status        CustomDomainStatus @default(PENDING)
  verification  Json?
  lastError     String?
  lastCheckedAt DateTime?
  verifiedAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  restaurant    Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([status, domain])
}

model Feature {
  id            String           @id @default(cuid())
  key           String           @unique
  name          String
  nameAr        String?
  description   String?
  descriptionAr String?
  valueType     FeatureValueType @default(BOOLEAN)
  displayOrder  Int              @default(0)
  isPublic      Boolean          @default(true)
  plans         PlanFeature[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model PlanFeature {
  planId    String
  featureId String
  enabled   Boolean @default(true)
  value     Int?
  plan      Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature   Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([planId, featureId])
  @@index([featureId])
}

model LaunchPromotion {
  id             String         @id @default(cuid())
  name           String
  enabled        Boolean        @default(false)
  startsAt       DateTime
  endsAt         DateTime
  trialDays      Int            @default(30)
  affectedPlanId String
  affectedPlan   Plan           @relation(fields: [affectedPlanId], references: [id])
  subscriptions  Subscription[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([enabled, startsAt, endsAt])
}

model Subscription {
  id                     String             @id @default(cuid())
  status                 SubscriptionStatus @default(TRIALING)
  startsAt               DateTime           @default(now())
  endsAt                 DateTime?
  restaurantId           String
  planId                 String
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  trialEndsAt            DateTime?
  launchPromotionId      String?
  provider               String?
  providerCustomerId     String?
  providerSubscriptionId String?            @unique
  providerOrderId        String?
  providerVariantId      String?
  providerStatus         String?
  providerUpdatedAt      DateTime?
  launchPromotion        LaunchPromotion?   @relation(fields: [launchPromotionId], references: [id])
  payments               Payment[]
  plan                   Plan               @relation(fields: [planId], references: [id])
  restaurant             Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, status])
  @@index([launchPromotionId])
}

model Payment {
  id                     String        @id @default(cuid())
  amount                 Decimal       @db.Decimal(10, 2)
  currency               String        @default("EGP")
  status                 PaymentStatus @default(PENDING)
  provider               String?
  reference              String?       @unique
  providerOrderId        String?
  providerSubscriptionId String?
  providerEventId        String?
  subscriptionId         String
  createdAt              DateTime      @default(now())
  subscription           Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

model BillingEvent {
  id              String    @id @default(cuid())
  provider        String
  providerEventId String
  eventName       String
  resourceId      String?
  occurredAt      DateTime?
  processedAt     DateTime  @default(now())

  @@unique([provider, providerEventId])
  @@index([provider, resourceId, occurredAt])
}

model BillingCheckoutIntent {
  id               String                      @id @default(cuid())
  publicIntentId   String                      @unique
  restaurantId     String
  initiatingUserId String
  planId           String
  variantId        String
  status           BillingCheckoutIntentStatus @default(PENDING)
  expiresAt        DateTime
  consumedAt       DateTime?
  createdAt        DateTime                    @default(now())
  restaurant       Restaurant                  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  initiatingUser   User                        @relation(fields: [initiatingUserId], references: [id], onDelete: Cascade)
  plan             Plan                        @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([restaurantId, status, expiresAt])
  @@index([initiatingUserId, status])
  @@index([expiresAt])
}

model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model ImportOperationLease {
  key          String   @id
  userId       String
  restaurantId String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([expiresAt])
  @@index([restaurantId, expiresAt])
  @@index([userId, expiresAt])
}

model Setting {
  id                             String     @id @default(cuid())
  taxRate                        Decimal    @default(0) @db.Decimal(5, 2)
  deliveryFee                    Decimal    @default(0) @db.Decimal(10, 2)
  deliveryFeeType                String     @default("FIXED")
  serviceFee                     Decimal    @default(0) @db.Decimal(10, 2)
  serviceFeeType                 String     @default("FIXED")
  taxType                        String     @default("PERCENTAGE")
  minimumOrder                   Decimal    @default(0) @db.Decimal(10, 2)
  allowOrdering                  Boolean    @default(true)
  allowOrdersOutsideHours        Boolean    @default(false)
  inventoryTrackingEnabled       Boolean    @default(false)
  setupChecklistDismissed        Boolean    @default(false)
  offersDelivery                 Boolean    @default(true)
  offersPickup                   Boolean    @default(true)
  offersDineIn                   Boolean    @default(false)
  restaurantId                   String     @unique
  estimatedOrderMinutes          Int        @default(30)
  reviewsEnabled                 Boolean    @default(true)
  reviewImagesEnabled            Boolean    @default(true)
  anonymousReviewsEnabled        Boolean    @default(true)
  requireCompletedOrderForReview Boolean    @default(false)
  autoPublishReviews             Boolean    @default(false)
  restaurant                     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

/// Platform-wide configuration. Values are JSON so new settings can be added
/// from Super Admin without a schema migration, while `valueType` keeps input
/// and runtime validation explicit.
model PlatformSetting {
  id           String                   @id @default(cuid())
  namespace    String
  key          String
  label        String
  labelAr      String?
  description  String?
  value        Json
  defaultValue Json?
  valueType    PlatformConfigValueType
  visibility   PlatformConfigVisibility @default(PRIVATE)
  isEditable   Boolean                  @default(true)
  validation   Json?
  updatedById  String?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  updatedBy    User?                    @relation("PlatformSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([namespace, key])
  @@index([namespace, updatedAt])
  @@index([visibility, namespace])
}

model FeatureFlag {
  id                String    @id @default(cuid())
  key               String    @unique
  name              String
  nameAr            String?
  description       String?
  enabled           Boolean   @default(false)
  rolloutPercentage Int       @default(100)
  conditions        Json?
  startsAt          DateTime?
  endsAt            DateTime?
  updatedById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  updatedBy         User?     @relation("FeatureFlagUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([enabled, startsAt, endsAt])
}

model HomepageSection {
  id           String   @id @default(cuid())
  key          String   @unique
  name         String
  nameAr       String?
  enabled      Boolean  @default(true)
  displayOrder Int      @default(0)
  content      Json
  updatedById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  updatedBy    User?    @relation("HomepageSectionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([enabled, displayOrder])
}

model Promotion {
  id                String                @id @default(cuid())
  restaurantId      String
  name              String
  nameAr            String?
  description       String?
  descriptionAr     String?
  type              PromotionType
  targetType        PromotionTargetType   @default(ORDER)
  value             Decimal               @default(0) @db.Decimal(10, 2)
  buyQuantity       Int?
  getQuantity       Int?
  freeProductId     String?
  minimumOrderValue Decimal?              @db.Decimal(10, 2)
  maximumDiscount   Decimal?              @db.Decimal(10, 2)
  minimumQuantity   Int?
  startsAt          DateTime?
  endsAt            DateTime?
  startTime         String?
  endTime           String?
  weekdays          Int[]                 @default([])
  firstOrderOnly    Boolean               @default(false)
  newCustomersOnly  Boolean               @default(false)
  returningOnly     Boolean               @default(false)
  totalUsageLimit   Int?
  perCustomerLimit  Int?
  usageCount        Int                   @default(0)
  requiresCoupon    Boolean               @default(false)
  autoApply         Boolean               @default(true)
  allowStacking     Boolean               @default(false)
  stackingRule      PromotionStackingRule @default(HIGHEST_WINS)
  priority          Int                   @default(0)
  exclusive         Boolean               @default(false)
  isActive          Boolean               @default(true)
  status            PromotionStatus       @default(DRAFT)
  archivedAt        DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  restaurant        Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  freeProduct       Product?              @relation("PromotionFreeProduct", fields: [freeProductId], references: [id], onDelete: SetNull)
  products          PromotionProduct[]
  categories        PromotionCategory[]
  branches          PromotionBranch[]
  coupons           Coupon[]
  usages            PromotionUsage[]
  orders            PromotionOrder[]

  @@index([restaurantId, status, isActive])
  @@index([restaurantId, startsAt, endsAt])
  @@index([restaurantId, priority])
}

model PromotionProduct {
  promotionId String
  productId   String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
  @@index([productId])
}

model PromotionCategory {
  promotionId String
  categoryId  String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([promotionId, categoryId])
  @@index([categoryId])
}

model PromotionBranch {
  promotionId String
  branchId    String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  branch      Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([promotionId, branchId])
  @@index([branchId])
}

model Coupon {
  id               String           @id @default(cuid())
  restaurantId     String
  promotionId      String
  code             String
  description      String?
  maximumUsage     Int?
  perCustomerLimit Int?
  usageCount       Int              @default(0)
  expiresAt        DateTime?
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  restaurant       Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  promotion        Promotion        @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  usages           PromotionUsage[]
  orders           PromotionOrder[]

  @@unique([restaurantId, code])
  @@index([restaurantId, isActive, expiresAt])
  @@index([promotionId])
}

model PromotionUsage {
  id             String     @id @default(cuid())
  restaurantId   String
  promotionId    String
  couponId       String?
  orderId        String
  customerUserId String?
  customerKey    String?
  discountAmount Decimal    @db.Decimal(10, 2)
  createdAt      DateTime   @default(now())
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  promotion      Promotion  @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  coupon         Coupon?    @relation(fields: [couponId], references: [id], onDelete: SetNull)
  order          Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer       User?      @relation(fields: [customerUserId], references: [id], onDelete: SetNull)

  @@unique([promotionId, orderId])
  @@index([restaurantId, createdAt])
  @@index([promotionId, customerUserId])
  @@index([promotionId, customerKey])
  @@index([couponId, createdAt])
}

model PromotionOrder {
  id             String        @id @default(cuid())
  orderId        String
  promotionId    String?
  couponId       String?
  promotionName  String
  promotionType  PromotionType
  discountAmount Decimal       @db.Decimal(10, 2)
  snapshot       Json
  createdAt      DateTime      @default(now())
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  promotion      Promotion?    @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  coupon         Coupon?       @relation(fields: [couponId], references: [id], onDelete: SetNull)

  @@unique([orderId, promotionId])
  @@index([orderId])
  @@index([promotionId, createdAt])
  @@index([couponId, createdAt])
}

model ProductOptionGroup {
  id            String                      @id @default(cuid())
  restaurantId  String
  name          String
  nameAr        String?
  description   String?
  descriptionAr String?
  isRequired    Boolean                     @default(false)
  minSelections Int                         @default(0)
  maxSelections Int                         @default(1)
  sortOrder     Int                         @default(0)
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt
  restaurant    Restaurant                  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  options       ProductOptionGroupItem[]
  products      ProductOptionGroupProduct[]

  @@index([restaurantId, sortOrder])
}

model ProductOption {
  id                  String                   @id @default(cuid())
  restaurantId        String
  name                String
  nameAr              String?
  description         String?
  descriptionAr       String?
  priceAdjustment     Decimal                  @default(0) @db.Decimal(10, 2)
  isAvailable         Boolean                  @default(true)
  sortOrder           Int                      @default(0)
  standaloneProductId String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  restaurant          Restaurant               @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  standaloneProduct   Product?                 @relation("StandaloneOptionProduct", fields: [standaloneProductId], references: [id], onDelete: SetNull)
  groups              ProductOptionGroupItem[]
  orderItems          OrderItemOption[]

  @@index([restaurantId, isAvailable, sortOrder])
  @@index([standaloneProductId])
}

model ProductOptionGroupItem {
  groupId   String
  optionId  String
  sortOrder Int                @default(0)
  group     ProductOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  option    ProductOption      @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([groupId, optionId])
  @@index([optionId])
}

model ProductOptionGroupProduct {
  groupId   String
  productId String
  sortOrder Int                @default(0)
  group     ProductOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  product   Product            @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([groupId, productId])
  @@index([productId, sortOrder])
}

model OrderItemOption {
  id          String         @id @default(cuid())
  orderItemId String
  optionId    String?
  name        String
  price       Decimal        @db.Decimal(10, 2)
  orderItem   OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  option      ProductOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@index([orderItemId])
  @@index([optionId])
}

model DeliveryDriver {
  id           String       @id @default(cuid())
  restaurantId String
  name         String
  phone        String
  whatsapp     String?
  photoUrl     String?
  vehicleType  String?
  status       DriverStatus @default(AVAILABLE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@index([restaurantId, status])
}

model RestaurantReview {
  id              String                  @id @default(cuid())
  restaurantId    String
  orderId         String?                 @unique
  customerUserId  String?
  customerName    String?
  foodQuality     Int
  deliverySpeed   Int
  packaging       Int
  staffBehavior   Int                     @default(5)
  overall         Int
  comment         String?
  ownerReply      String?
  repliedAt       DateTime?
  abuseReportedAt DateTime?
  ipHash          String?
  isVerified      Boolean                 @default(false)
  status          ReviewStatus            @default(PENDING)
  publishedAt     DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  restaurant      Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order           Order?                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  images          RestaurantReviewImage[]

  @@index([restaurantId, status, createdAt])
  @@index([restaurantId, overall])
  @@index([restaurantId, publishedAt])
  @@index([restaurantId, ipHash, createdAt])
}

model RestaurantReviewImage {
  id        String           @id @default(cuid())
  reviewId  String
  url       String
  path      String
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())
  review    RestaurantReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId, sortOrder])
}

model RestaurantNotification {
  id           String                       @id @default(cuid())
  restaurantId String
  type         RestaurantNotificationType
  title        String
  body         String?
  href         String?
  dedupeKey    String?
  createdAt    DateTime                     @default(now())
  restaurant   Restaurant                   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  reads        RestaurantNotificationRead[]

  @@unique([restaurantId, dedupeKey])
  @@index([restaurantId, createdAt])
}

model RestaurantNotificationRead {
  notificationId String
  userId         String
  readAt         DateTime               @default(now())
  notification   RestaurantNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@index([userId, readAt])
}

model WhatsAppOtp {
  id         String    @id @default(cuid())
  phone      String    @unique
  codeHash   String
  expiresAt  DateTime
  verifiedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([expiresAt])
}

model WhatsAppMessage {
  id               String    @id @default(cuid())
  metaMessageId    String    @unique
  notificationType String?
  templateName     String?
  direction        String    @default("OUTBOUND")
  status           String    @default("accepted")
  errorCode        String?
  sentAt           DateTime?
  deliveredAt      DateTime?
  readAt           DateTime?
  failedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([notificationType, createdAt])
}

model AnalyticsEvent {
  id           String     @id @default(cuid())
  type         String
  productId    String?
  metadata     Json?
  ipHash       String?
  restaurantId String
  createdAt    DateTime   @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, type, createdAt])
}

model AuditLog {
  id           String      @id @default(cuid())
  action       String
  entity       String
  entityId     String?
  metadata     Json?
  ipAddress    String?
  userId       String?
  restaurantId String?
  createdAt    DateTime    @default(now())
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user         User?       @relation(fields: [userId], references: [id])

  @@index([restaurantId, createdAt])
}

enum Role {
  SUPER_ADMIN
  RESTAURANT_OWNER
  STAFF
  CUSTOMER
}

enum OrderStatus {
  NEW
  CONFIRMED
  PREPARING
  READY
  ASSIGNED_TO_DRIVER
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
  REJECTED
  FAILED_DELIVERY
}

enum FulfillmentType {
  DELIVERY
  PICKUP
  DINE_IN
}

enum DriverStatus {
  AVAILABLE
  BUSY
  OFFLINE
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
}

enum ProductAvailability {
  AVAILABLE
  TEMPORARILY_UNAVAILABLE
  HIDDEN
}

enum RestaurantNotificationType {
  NEW_ORDER
  APPROVAL_REQUIRED
  OUT_OF_STOCK
  NEW_CUSTOMER
  FIRST_QR_SCAN
  NEW_REVIEW
  LOW_RATING
  DRIVER_ASSIGNED
  DRIVER_CHANGED
  DELIVERY_COMPLETED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum BillingCheckoutIntentStatus {
  PENDING
  CONSUMED
  FAILED
}

enum FeatureValueType {
  BOOLEAN
  NUMBER
}

enum PlatformConfigValueType {
  STRING
  NUMBER
  BOOLEAN
  JSON
  SECRET
}

enum PlatformConfigVisibility {
  PUBLIC
  PRIVATE
  SECRET
}

enum CustomDomainStatus {
  PENDING
  VERIFIED
  ERROR
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
  BUY_X_GET_Y
  FREE_ITEM
  FREE_DELIVERY
}

enum PromotionTargetType {
  ORDER
  PRODUCT
  CATEGORY
  BRANCH
  RESTAURANT
  COLLECTION
}

enum PromotionStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum PromotionStackingRule {
  ALLOW
  PREVENT
  HIGHEST_WINS
}
