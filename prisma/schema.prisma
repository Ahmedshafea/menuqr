generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String               @id @default(cuid())
  name                  String
  email                 String               @unique
  passwordHash          String
  emailVerified         DateTime?
  image                 String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  phone                 String?
  language              String               @default("ar")
  role                  String?
  auditLogs             AuditLog[]
  customerProfile       CustomerProfile?
  customerOrders        Order[]              @relation("CustomerOrders")
  orderMessages         OrderMessage[]
  orderStatusChanges    OrderStatusHistory[]
  orderActions          OrderActionLog[]
  notificationsRead     RestaurantNotificationRead[]
  resetTokens           PasswordResetToken[]
  restaurantMemberships RestaurantMember[]
  roles                 UserRole[]
  verificationTokens    VerificationToken[]
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  role      Role
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role])
}

model RestaurantMember {
  id           String     @id @default(cuid())
  userId       String
  restaurantId String
  role         Role       @default(STAFF)
  createdAt    DateTime   @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId])
  @@index([restaurantId, role])
}

model CustomerProfile {
  id                  String                       @id @default(cuid())
  userId              String                       @unique
  avatar              String?
  birthDate           DateTime?
  marketingConsent    Boolean                      @default(false)
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  addresses           CustomerAddress[]
  favoriteProducts    CustomerFavoriteProduct[]
  favoriteRestaurants CustomerFavoriteRestaurant[]
  user                User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CustomerAddress {
  id         String          @id @default(cuid())
  customerId String
  title      String
  address    String
  latitude   Decimal?        @db.Decimal(10, 7)
  longitude  Decimal?        @db.Decimal(10, 7)
  isDefault  Boolean         @default(false)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, isDefault])
}

model CustomerFavoriteRestaurant {
  customerId   String
  restaurantId String
  createdAt    DateTime        @default(now())
  customer     CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  restaurant   Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@id([customerId, restaurantId])
  @@index([restaurantId])
}

model CustomerFavoriteProduct {
  customerId String
  productId  String
  createdAt  DateTime        @default(now())
  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([customerId, productId])
  @@index([productId])
}

model VerificationToken {
  id      String   @id @default(cuid())
  token   String   @unique
  expires DateTime
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  token   String   @unique
  expires DateTime
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Restaurant {
  id                String                       @id @default(cuid())
  name              String
  nameAr            String?
  slug              String                       @unique
  description       String?
  email             String?
  phone             String?
  whatsapp          String
  logoUrl           String?
  coverUrl          String?
  primaryColor      String                       @default("#e85d2a")
  accentColor       String                       @default("#f6c453")
  currency          String                       @default("EGP")
  locale            String                       @default("en")
  isActive          Boolean                      @default(true)
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  address           String?
  descriptionAr     String?
  mapUrl            String?
  facebookUrl       String?
  instagramUrl      String?
  analytics         AnalyticsEvent[]
  auditLogs         AuditLog[]
  branches          Branch[]
  categories        Category[]
  customerFavorites CustomerFavoriteRestaurant[]
  orders            Order[]
  products          Product[]
  members           RestaurantMember[]
  settings          Setting?
  subscriptions     Subscription[]
  notifications     RestaurantNotification[]
  optionGroups      ProductOptionGroup[]
  options           ProductOption[]
  drivers           DeliveryDriver[]
  reviews           RestaurantReview[]
}

model Branch {
  id           String        @id @default(cuid())
  name         String
  address      String
  mapUrl       String?
  phone        String?
  isActive     Boolean       @default(true)
  restaurantId String
  createdAt    DateTime      @default(now())
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders       Order[]
  workingHours WorkingHour[]

  @@index([restaurantId, isActive])
}

model WorkingHour {
  id        String  @id @default(cuid())
  dayOfWeek Int
  opensAt   String?
  closesAt  String?
  isClosed  Boolean @default(false)
  branchId  String
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, dayOfWeek])
}

model Category {
  id           String     @id @default(cuid())
  name         String
  nameAr       String?
  description  String?
  sortOrder    Int        @default(0)
  isActive     Boolean    @default(true)
  restaurantId String
  createdAt    DateTime   @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products     Product[]

  @@index([restaurantId, sortOrder])
}

model Product {
  id                String                    @id @default(cuid())
  name              String
  nameAr            String?
  description       String?
  descriptionAr     String?
  price             Decimal                   @db.Decimal(10, 2)
  isAvailable       Boolean                   @default(true)
  availability      ProductAvailability       @default(AVAILABLE)
  isFeatured        Boolean                   @default(false)
  sortOrder         Int                       @default(0)
  restaurantId      String
  categoryId        String
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  stock             Int?
  lowStockThreshold Int?
  customerFavorites CustomerFavoriteProduct[]
  extras            Extra[]
  orderItems        OrderItem[]
  category          Category                  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  restaurant        Restaurant                @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  images            ProductImage[]
  optionGroups      ProductOptionGroupProduct[]
  standaloneOptions ProductOption[]             @relation("StandaloneOptionProduct")

  @@index([restaurantId, categoryId])
  @@index([categoryId, sortOrder])
  @@index([restaurantId, isAvailable, sortOrder])
  @@index([restaurantId, stock])
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  publicId  String?
  alt       String?
  sortOrder Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model Extra {
  id              String           @id @default(cuid())
  name            String
  nameAr          String?
  price           Decimal          @db.Decimal(10, 2)
  isAvailable     Boolean          @default(true)
  productId       String
  product         Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItemExtras OrderItemExtra[]

  @@index([productId, isAvailable])
}

model Order {
  id              String         @id @default(cuid())
  orderNumber     String         @unique
  customerName    String
  customerPhone   String
  deliveryAddress String?
  notes           String?
  subtotal        Decimal        @db.Decimal(10, 2)
  discountAmount  Decimal        @default(0) @db.Decimal(10, 2)
  deliveryFee     Decimal        @default(0) @db.Decimal(10, 2)
  serviceFee      Decimal        @default(0) @db.Decimal(10, 2)
  taxAmount       Decimal        @default(0) @db.Decimal(10, 2)
  total           Decimal        @db.Decimal(10, 2)
  status          OrderStatus    @default(NEW)
  restaurantId    String
  branchId        String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  accessToken     String         @unique
  customerUserId  String?
  branch          Branch?        @relation(fields: [branchId], references: [id])
  customer        User?          @relation("CustomerOrders", fields: [customerUserId], references: [id], map: "Order_customerId_fkey")
  restaurant      Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items           OrderItem[]
  messages        OrderMessage[]
  statusHistory   OrderStatusHistory[]
  actionLogs      OrderActionLog[]
  driver          DeliveryDriver? @relation(fields: [driverId], references: [id], onDelete: SetNull)
  driverId        String?
  fulfillmentType FulfillmentType @default(DELIVERY)
  driverAssignedAt DateTime?
  outForDeliveryAt DateTime?
  deliveredAt     DateTime?
  estimatedArrivalAt DateTime?
  review           RestaurantReview?

  @@index([restaurantId, createdAt])
  @@index([customerUserId, createdAt])
  @@index([restaurantId, status, createdAt])
  @@index([restaurantId, fulfillmentType, createdAt])
  @@index([driverId, status])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  userId    String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

model OrderActionLog {
  id        String   @id @default(cuid())
  orderId   String
  userId    String?
  action    String
  details   Json?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

model OrderMessage {
  id        String   @id @default(cuid())
  body      String
  sender    Role
  orderId   String
  userId    String?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@index([orderId, createdAt])
}

model OrderItem {
  id          String           @id @default(cuid())
  productName String
  unitPrice   Decimal          @db.Decimal(10, 2)
  quantity    Int
  notes       String?
  isComplimentary Boolean @default(false)
  orderId     String
  productId   String?
  order       Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product?         @relation(fields: [productId], references: [id])
  extras      OrderItemExtra[]
  options     OrderItemOption[]

  @@index([orderId])
}

model OrderItemExtra {
  id          String    @id @default(cuid())
  name        String
  price       Decimal   @db.Decimal(10, 2)
  orderItemId String
  extraId     String?
  extra       Extra?    @relation(fields: [extraId], references: [id])
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
}

model Plan {
  id               String          @id @default(cuid())
  name             String          @unique
  price            Decimal         @db.Decimal(10, 2)
  interval         BillingInterval @default(MONTHLY)
  maxProducts      Int
  maxBranches      Int
  maxStaff         Int
  analyticsEnabled Boolean         @default(false)
  customDomain     Boolean         @default(false)
  createdAt        DateTime        @default(now())
  subscriptions    Subscription[]
}

model Subscription {
  id           String             @id @default(cuid())
  status       SubscriptionStatus @default(TRIALING)
  startsAt     DateTime           @default(now())
  endsAt       DateTime?
  restaurantId String
  planId       String
  createdAt    DateTime           @default(now())
  payments     Payment[]
  plan         Plan               @relation(fields: [planId], references: [id])
  restaurant   Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, status])
}

model Payment {
  id             String        @id @default(cuid())
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("EGP")
  status         PaymentStatus @default(PENDING)
  provider       String?
  reference      String?       @unique
  subscriptionId String
  createdAt      DateTime      @default(now())
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

model Setting {
  id                    String     @id @default(cuid())
  taxRate               Decimal    @default(0) @db.Decimal(5, 2)
  deliveryFee           Decimal    @default(0) @db.Decimal(10, 2)
  deliveryFeeType       String     @default("FIXED")
  serviceFee            Decimal    @default(0) @db.Decimal(10, 2)
  serviceFeeType        String     @default("FIXED")
  taxType               String     @default("PERCENTAGE")
  discountValue         Decimal    @default(0) @db.Decimal(10, 2)
  discountType          String     @default("FIXED")
  minimumOrder          Decimal    @default(0) @db.Decimal(10, 2)
  allowOrdering         Boolean    @default(true)
  allowOrdersOutsideHours Boolean  @default(false)
  inventoryTrackingEnabled Boolean @default(false)
  setupChecklistDismissed Boolean  @default(false)
  offersDelivery          Boolean  @default(true)
  offersPickup            Boolean  @default(true)
  offersDineIn            Boolean  @default(false)
  restaurantId          String     @unique
  estimatedOrderMinutes Int        @default(30)
  restaurant            Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model ProductOptionGroup {
  id           String                      @id @default(cuid())
  restaurantId String
  name         String
  nameAr       String?
  description  String?
  descriptionAr String?
  isRequired   Boolean                     @default(false)
  minSelections Int                        @default(0)
  maxSelections Int                        @default(1)
  sortOrder    Int                         @default(0)
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
  restaurant   Restaurant                  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  options      ProductOptionGroupItem[]
  products     ProductOptionGroupProduct[]

  @@index([restaurantId, sortOrder])
}

model ProductOption {
  id                  String                   @id @default(cuid())
  restaurantId        String
  name                String
  nameAr              String?
  description         String?
  descriptionAr       String?
  priceAdjustment     Decimal                  @default(0) @db.Decimal(10, 2)
  isAvailable         Boolean                  @default(true)
  sortOrder           Int                      @default(0)
  standaloneProductId String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  restaurant          Restaurant               @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  standaloneProduct   Product?                 @relation("StandaloneOptionProduct", fields: [standaloneProductId], references: [id], onDelete: SetNull)
  groups              ProductOptionGroupItem[]
  orderItems          OrderItemOption[]

  @@index([restaurantId, isAvailable, sortOrder])
  @@index([standaloneProductId])
}

model ProductOptionGroupItem {
  groupId   String
  optionId  String
  sortOrder Int                @default(0)
  group     ProductOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  option    ProductOption      @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([groupId, optionId])
  @@index([optionId])
}

model ProductOptionGroupProduct {
  groupId   String
  productId String
  sortOrder Int                @default(0)
  group     ProductOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  product   Product            @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([groupId, productId])
  @@index([productId, sortOrder])
}

model OrderItemOption {
  id          String         @id @default(cuid())
  orderItemId String
  optionId    String?
  name        String
  price       Decimal        @db.Decimal(10, 2)
  orderItem   OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  option      ProductOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@index([orderItemId])
  @@index([optionId])
}

model DeliveryDriver {
  id           String       @id @default(cuid())
  restaurantId String
  name         String
  phone        String
  whatsapp     String?
  photoUrl     String?
  vehicleType  String?
  status       DriverStatus @default(AVAILABLE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@index([restaurantId, status])
}

model RestaurantReview {
  id             String       @id @default(cuid())
  restaurantId   String
  orderId        String       @unique
  customerUserId String?
  foodQuality    Int
  deliverySpeed  Int
  packaging      Int
  overall        Int
  comment        String?
  status         ReviewStatus @default(PENDING)
  publishedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  restaurant     Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([restaurantId, status, createdAt])
  @@index([restaurantId, overall])
}

model RestaurantNotification {
  id           String                     @id @default(cuid())
  restaurantId String
  type         RestaurantNotificationType
  title        String
  body         String?
  href         String?
  dedupeKey    String?
  createdAt    DateTime                   @default(now())
  restaurant   Restaurant                 @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  reads        RestaurantNotificationRead[]

  @@unique([restaurantId, dedupeKey])
  @@index([restaurantId, createdAt])
}

model RestaurantNotificationRead {
  notificationId String
  userId         String
  readAt         DateTime               @default(now())
  notification   RestaurantNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@index([userId, readAt])
}

model AnalyticsEvent {
  id           String     @id @default(cuid())
  type         String
  productId    String?
  metadata     Json?
  ipHash       String?
  restaurantId String
  createdAt    DateTime   @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, type, createdAt])
}

model AuditLog {
  id           String      @id @default(cuid())
  action       String
  entity       String
  entityId     String?
  metadata     Json?
  ipAddress    String?
  userId       String?
  restaurantId String?
  createdAt    DateTime    @default(now())
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user         User?       @relation(fields: [userId], references: [id])

  @@index([restaurantId, createdAt])
}

enum Role {
  SUPER_ADMIN
  RESTAURANT_OWNER
  STAFF
  CUSTOMER
}

enum OrderStatus {
  NEW
  CONFIRMED
  PREPARING
  READY
  ASSIGNED_TO_DRIVER
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
  REJECTED
  FAILED_DELIVERY
}

enum FulfillmentType {
  DELIVERY
  PICKUP
  DINE_IN
}

enum DriverStatus {
  AVAILABLE
  BUSY
  OFFLINE
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
}

enum ProductAvailability {
  AVAILABLE
  TEMPORARILY_UNAVAILABLE
  HIDDEN
}

enum RestaurantNotificationType {
  NEW_ORDER
  APPROVAL_REQUIRED
  OUT_OF_STOCK
  NEW_CUSTOMER
  FIRST_QR_SCAN
  NEW_REVIEW
  LOW_RATING
  DRIVER_ASSIGNED
  DRIVER_CHANGED
  DELIVERY_COMPLETED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}
